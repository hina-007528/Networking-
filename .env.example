# ---------------------------------------------------------------------------
# Majawar X Network platform — example environment file
# Copy to .env and fill in real values. NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://stormfiber:stormfiber@localhost:5432/stormfiber?schema=public
POSTGRES_USER=stormfiber
POSTGRES_PASSWORD=stormfiber
POSTGRES_DB=stormfiber

# --- Cache / queues ---------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- API --------------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
API_GLOBAL_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,https://networking-admin.vercel.app,https://www.majawarxnetworks.online,https://majawarxnetworks.online,https://admin.majawarxnetworks.online
THROTTLE_TTL=60
THROTTLE_LIMIT=120
SWAGGER_ENABLED=true

# --- Auth -------------------------------------------------------------------
JWT_SECRET=replace-with-a-64-char-random-string-in-every-environment
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# --- OTP --------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=6
# When true the generated OTP is returned by the API and logged. DEV ONLY.
OTP_DEV_ECHO=false

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_BRAND_NAME=Majawar X Network
NEXT_PUBLIC_SUPPORT_PHONE=0303 0002291

# --- Mail -------------------------------------------------------------------
# MAIL_PROVIDER: console | smtp | resend
# Local Hostinger SMTP works on your PC. Render free blocks ports 465/587 — use resend there.
MAIL_PROVIDER=console
MAIL_FROM="Majawar X Network <info@majawarxnetworks.online>"
MAIL_ADMIN_INBOX=ceo@majawarxnetworks.online,info@majawarxnetworks.online
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@majawarxnetworks.online
SMTP_PASSWORD=
RESEND_API_KEY=

# --- SMS --------------------------------------------------------------------
# SMS_PROVIDER: console | http
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=MajawarX

# WhatsApp Cloud API (optional). Email still goes to MAIL_ADMIN_INBOX either way.
WHATSAPP_ADMIN=+923030002291
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Payments ---------------------------------------------------------------
# PAYMENT_PROVIDER: mock | card | bank | wallet
PAYMENT_PROVIDER=mock
PAYMENT_SECRET=replace-with-provider-webhook-signing-secret
PAYMENT_RETURN_URL=http://localhost:3000/dashboard/payments/return
PAYMENT_CURRENCY=PKR

# --- Storage ----------------------------------------------------------------
# STORAGE_PROVIDER: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL=http://localhost:4000/api/v1/files
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=debug
SENTRY_DSN=
METRICS_ENABLED=false

# --- Seed credentials (development only) ------------------------------------
SEED_SUPER_ADMIN_EMAIL=superadmin@stormfiber.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_EMAIL=admin@stormfiber.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_MANAGER_EMAIL=manager@stormfiber.local
SEED_MANAGER_PASSWORD=ChangeMe!2026
SEED_SUPPORT_EMAIL=support@stormfiber.local
SEED_SUPPORT_PASSWORD=ChangeMe!2026
SEED_FINANCE_EMAIL=finance@stormfiber.local
SEED_FINANCE_PASSWORD=ChangeMe!2026
SEED_SALES_EMAIL=sales@stormfiber.local
SEED_SALES_PASSWORD=ChangeMe!2026
SEED_CUSTOMER_EMAIL=customer@stormfiber.local
SEED_CUSTOMER_PASSWORD=ChangeMe!2026
SEED_CUSTOMER_MOBILE=03001234567
