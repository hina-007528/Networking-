{
  "name": "@stormfiber/api",
  "version": "1.0.0",
  "private": true,
  "description": "StormFiber platform REST API",
  "main": "dist/apps/api/src/main.js",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/apps/api/src/main.js",
    "start:prod": "node dist/apps/api/src/main.js",
    "worker": "node dist/apps/api/src/worker.js",
    "worker:dev": "nest start --entryFile worker --watch",
    "lint": "eslint src prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "prisma:migration:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "clean": "rimraf dist .turbo coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "8.1.0",
    "@nestjs/terminus": "10.2.3",
    "@nestjs/throttler": "6.3.0",
    "@prisma/client": "6.2.1",
    "bcryptjs": "2.4.3",
    "bullmq": "5.34.10",
    "cookie-parser": "1.4.7",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "nanoid": "3.3.8",
    "nodemailer": "6.9.16",
    "pdfkit": "0.16.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.1",
    "zod-to-json-schema": "3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.15",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/node": "22.10.7",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.13.9",
    "@types/supertest": "6.0.2",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.18.0",
    "prisma": "6.2.1",
    "rimraf": "6.0.1",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.10",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "unplugin-swc": "1.5.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "2.1.8"
  }
}
