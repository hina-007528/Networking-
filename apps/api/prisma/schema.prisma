// StormFiber platform — PostgreSQL schema
//
// Conventions used throughout:
//   * UUID primary keys, generated by the database.
//   * snake_case table and column names via @map / @@map; camelCase in application code.
//   * Money is Decimal(12,2). It is never a float, and it is never computed in the browser.
//   * createdAt / updatedAt on every mutable table.
//   * deletedAt (soft delete) only on catalog and content tables, where an operator may want to
//     retract something without breaking historical invoices that reference it.
//   * Explicit indexes on every foreign key used for filtering, and on the coverage lookup path.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ============================================================================
   Identity, access control and sessions
   ============================================================================ */

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES_AGENT
  SUPPORT_AGENT
  FINANCE_AGENT
  CUSTOMER
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  mobile          String     @unique
  passwordHash    String     @map("password_hash")
  firstName       String     @map("first_name")
  lastName        String     @map("last_name")
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  mobileVerifiedAt DateTime? @map("mobile_verified_at")
  avatarUrl       String?    @map("avatar_url")
  lastLoginAt     DateTime?  @map("last_login_at")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil     DateTime?  @map("locked_until")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  roles                UserRole[]
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  customer             Customer?
  auditLogs            AuditLog[]
  notifications        Notification[]
  assignedTickets      Ticket[]                    @relation("TicketAssignee")
  ticketMessages       TicketMessage[]
  reviewedApplications Application[]               @relation("ApplicationReviewer")
  applicationHistory   ApplicationStatusHistory[]
  ticketStatusHistory  TicketStatusHistory[]
  subscriptionHistory  SubscriptionHistory[]
  assignedCallbacks    CallbackRequest[]           @relation("CallbackAssignee")
  assignedLeads        CoverageLead[]              @relation("LeadAssignee")
  requestedRefunds     Refund[]                    @relation("RefundRequester")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  label       String
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  label     String
  group     String
  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Rotating refresh tokens. Only a hash is stored, so a database leak cannot mint sessions.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  family     String    @db.Uuid
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  /// Set when this token was exchanged, which lets us detect replay of a rotated token.
  replacedById String? @map("replaced_by_id") @db.Uuid
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  APPLICATION
  PASSWORD_RESET
  MOBILE_VERIFICATION
}

/// One-time passcodes. The code itself is hashed; only attempt metadata is readable.
model OtpRequest {
  id           String     @id @default(uuid()) @db.Uuid
  mobile       String
  email        String?
  purpose      OtpPurpose
  codeHash     String     @map("code_hash")
  attempts     Int        @default(0)
  maxAttempts  Int        @default(5) @map("max_attempts")
  expiresAt    DateTime   @map("expires_at")
  verifiedAt   DateTime?  @map("verified_at")
  consumedAt   DateTime?  @map("consumed_at")
  /// Hash of the short-lived proof handed to the client after successful verification.
  proofHash    String?    @map("proof_hash")
  proofExpiresAt DateTime? @map("proof_expires_at")
  ipAddress    String?    @map("ip_address")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([mobile, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_requests")
}

/* ============================================================================
   Geography and coverage
   ============================================================================ */

enum CoverageStatus {
  AVAILABLE
  NOT_AVAILABLE
  COMING_SOON
}

model City {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  slug          String    @unique
  code          String    @unique
  /// Landline dial code used to build the city helpline, e.g. `042`.
  dialCode      String    @map("dial_code")
  province      String
  isActive      Boolean   @default(true) @map("is_active")
  /// False for a city that is announced but not yet serving customers.
  isLive        Boolean   @default(true) @map("is_live")
  latitude      Decimal?  @db.Decimal(9, 6)
  longitude     Decimal?  @db.Decimal(9, 6)
  branchAddress String?   @map("branch_address")
  mapUrl        String?   @map("map_url")
  displayOrder  Int       @default(0) @map("display_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  areas          Area[]
  coverageZones  CoverageZone[]
  coverageChecks CoverageCheck[]
  coverageLeads  CoverageLead[]
  planPrices     PlanPrice[]
  cityTaxRules   CityTaxRule[]
  customers      Customer[]
  applications   Application[]
  subscriptions  Subscription[]
  callbacks      CallbackRequest[]
  analyticsEvents AnalyticsEvent[]

  @@index([isActive, displayOrder])
  @@map("cities")
}

model Area {
  id               String         @id @default(uuid()) @db.Uuid
  cityId           String         @map("city_id") @db.Uuid
  name             String
  slug             String
  coverageStatus   CoverageStatus @default(NOT_AVAILABLE) @map("coverage_status")
  expectedLiveDate DateTime?      @map("expected_live_date") @db.Date
  isActive         Boolean        @default(true) @map("is_active")
  displayOrder     Int            @default(0) @map("display_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  city           City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  subAreas       SubArea[]
  coverageZones  CoverageZone[]
  coverageChecks CoverageCheck[]
  coverageLeads  CoverageLead[]
  customers      Customer[]
  applications   Application[]
  callbacks      CallbackRequest[]

  @@unique([cityId, slug])
  @@index([cityId, isActive])
  @@index([coverageStatus])
  @@map("areas")
}

model SubArea {
  id               String         @id @default(uuid()) @db.Uuid
  areaId           String         @map("area_id") @db.Uuid
  name             String
  slug             String
  coverageStatus   CoverageStatus @default(NOT_AVAILABLE) @map("coverage_status")
  expectedLiveDate DateTime?      @map("expected_live_date") @db.Date
  isActive         Boolean        @default(true) @map("is_active")
  displayOrder     Int            @default(0) @map("display_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  area           Area            @relation(fields: [areaId], references: [id], onDelete: Cascade)
  coverageZones  CoverageZone[]
  coverageChecks CoverageCheck[]
  coverageLeads  CoverageLead[]
  customers      Customer[]
  applications   Application[]

  @@unique([areaId, slug])
  @@index([areaId, isActive])
  @@index([coverageStatus])
  @@map("sub_areas")
}

/// The authoritative coverage record. Resolution order is sub-area, then area, then city.
model CoverageZone {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  cityId           String         @map("city_id") @db.Uuid
  areaId           String?        @map("area_id") @db.Uuid
  subAreaId        String?        @map("sub_area_id") @db.Uuid
  status           CoverageStatus
  expectedLiveDate DateTime?      @map("expected_live_date") @db.Date
  capacityNote     String?        @map("capacity_note")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  city    City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  area    Area?    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  subArea SubArea? @relation(fields: [subAreaId], references: [id], onDelete: Cascade)

  @@unique([cityId, areaId, subAreaId])
  @@index([cityId, status, isActive])
  @@index([subAreaId])
  @@index([areaId])
  @@map("coverage_zones")
}

/// Every coverage lookup is recorded, which is what powers the "where should we build next" report.
model CoverageCheck {
  id         String         @id @default(uuid()) @db.Uuid
  cityId     String         @map("city_id") @db.Uuid
  areaId     String?        @map("area_id") @db.Uuid
  subAreaId  String?        @map("sub_area_id") @db.Uuid
  address    String?
  mobile     String?
  result     CoverageStatus
  sessionId  String?        @map("session_id")
  ipAddress  String?        @map("ip_address")
  userAgent  String?        @map("user_agent")
  createdAt  DateTime       @default(now()) @map("created_at")

  city    City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  area    Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  subArea SubArea? @relation(fields: [subAreaId], references: [id], onDelete: SetNull)
  leads   CoverageLead[]

  @@index([cityId, createdAt])
  @@index([result, createdAt])
  @@index([createdAt])
  @@map("coverage_checks")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model CoverageLead {
  id           String     @id @default(uuid()) @db.Uuid
  checkId      String?    @map("check_id") @db.Uuid
  name         String
  mobile       String
  email        String?
  cityId       String     @map("city_id") @db.Uuid
  areaId       String?    @map("area_id") @db.Uuid
  subAreaId    String?    @map("sub_area_id") @db.Uuid
  address      String?
  notes        String?
  status       LeadStatus @default(NEW)
  /// Copied from the coverage result so the lead keeps its original context.
  coverageResult CoverageStatus @map("coverage_result")
  assignedToId String?    @map("assigned_to_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  check      CoverageCheck? @relation(fields: [checkId], references: [id], onDelete: SetNull)
  city       City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  area       Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  subArea    SubArea?       @relation(fields: [subAreaId], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([cityId])
  @@index([mobile])
  @@map("coverage_leads")
}

/* ============================================================================
   Product and plan catalog
   ============================================================================ */

enum ServiceType {
  INTERNET
  TV
  PHONE
}

enum PlanKind {
  INTERNET
  TV
  PHONE
  DOUBLE_PLAY
  TRIPLE_PLAY
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  EXPIRED
  ARCHIVED
}

model ProductCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("product_categories")
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  slug            String        @unique
  serviceType     ServiceType   @map("service_type")
  categoryId      String?       @map("category_id") @db.Uuid
  tagline         String
  description     String
  heroHeadline    String        @map("hero_headline")
  heroSubheadline String?       @map("hero_subheadline")
  imageUrl        String?       @map("image_url")
  iconKey         String?       @map("icon_key")
  status          PublishStatus @default(PUBLISHED)
  displayOrder    Int           @default(0) @map("display_order")
  seoTitle        String?       @map("seo_title")
  seoDescription  String?       @map("seo_description")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  features ProductFeature[]

  @@index([status, displayOrder])
  @@map("products")
}

model ProductFeature {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  title        String
  description  String
  iconKey      String?  @map("icon_key")
  imageUrl     String?  @map("image_url")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, displayOrder])
  @@map("product_features")
}

model PlanCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  kind         PlanKind
  description  String?
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  plans Plan[]

  @@index([displayOrder])
  @@map("plan_categories")
}

enum DiscountKind {
  PERCENTAGE
  FIXED
}

model Promotion {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  slug           String        @unique
  description    String?
  code           String?       @unique
  discountKind   DiscountKind  @map("discount_kind")
  discountValue  Decimal       @map("discount_value") @db.Decimal(12, 2)
  /// Billing cycles the discount applies to. Null means it applies for the life of the plan.
  durationMonths Int?          @map("duration_months")
  badgeText      String?       @map("badge_text")
  imageUrl       String?       @map("image_url")
  status         PublishStatus @default(DRAFT)
  startsAt       DateTime?     @map("starts_at")
  endsAt         DateTime?     @map("ends_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  plans Plan[]

  @@index([status, startsAt, endsAt])
  @@map("promotions")
}

model Plan {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String        @unique
  description      String
  shortDescription String?       @map("short_description")
  kind             PlanKind
  categoryId       String?       @map("category_id") @db.Uuid
  promotionId      String?       @map("promotion_id") @db.Uuid
  /// Services bundled into the plan. Denormalised for fast filtering by service.
  services         ServiceType[]
  speedMbps        Int?          @map("speed_mbps")
  uploadMbps       Int?          @map("upload_mbps")
  tvChannels       Int?          @map("tv_channels")
  voiceMinutes     Int?          @map("voice_minutes")
  /// Default nationwide price. A PlanPrice row overrides it per city.
  monthlyPrice     Decimal       @map("monthly_price") @db.Decimal(12, 2)
  installationPrice Decimal      @default(0) @map("installation_price") @db.Decimal(12, 2)
  currency         String        @default("PKR") @db.Char(3)
  status           PublishStatus @default(DRAFT)
  featured         Boolean       @default(false)
  displayOrder     Int           @default(0) @map("display_order")
  badgeText        String?       @map("badge_text")
  metadata         Json          @default("{}")
  seoTitle         String?       @map("seo_title")
  seoDescription   String?       @map("seo_description")
  publishedAt      DateTime?     @map("published_at")
  expiresAt        DateTime?     @map("expires_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  category      PlanCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  promotion     Promotion?      @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  features      PlanFeature[]
  addons        PlanAddonLink[]
  prices        PlanPrice[]
  applications  Application[]
  subscriptions Subscription[]
  changeRequests SubscriptionChangeRequest[]
  analyticsEvents AnalyticsEvent[]

  @@index([status, featured, displayOrder])
  @@index([kind, status])
  @@index([speedMbps])
  @@index([categoryId])
  @@map("plans")
}

model PlanFeature {
  id           String   @id @default(uuid()) @db.Uuid
  planId       String   @map("plan_id") @db.Uuid
  label        String
  value        String?
  iconKey      String?  @map("icon_key")
  highlighted  Boolean  @default(false)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, displayOrder])
  @@map("plan_features")
}

model PlanAddon {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  slug         String      @unique
  description  String?
  serviceType  ServiceType @map("service_type")
  monthlyPrice Decimal     @default(0) @map("monthly_price") @db.Decimal(12, 2)
  oneTimePrice Decimal     @default(0) @map("one_time_price") @db.Decimal(12, 2)
  currency     String      @default("PKR") @db.Char(3)
  isActive     Boolean     @default(true) @map("is_active")
  displayOrder Int         @default(0) @map("display_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")

  plans             PlanAddonLink[]
  subscriptionItems SubscriptionItem[]
  changeRequests    SubscriptionChangeRequest[]

  @@index([isActive, displayOrder])
  @@map("plan_addons")
}

/// Which add-ons may be attached to which plan.
model PlanAddonLink {
  planId  String @map("plan_id") @db.Uuid
  addonId String @map("addon_id") @db.Uuid

  plan  Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  addon PlanAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([planId, addonId])
  @@index([addonId])
  @@map("plan_addon_links")
}

/// City-specific pricing. Presence of a row also means the plan is sold in that city.
model PlanPrice {
  id                String   @id @default(uuid()) @db.Uuid
  planId            String   @map("plan_id") @db.Uuid
  cityId            String   @map("city_id") @db.Uuid
  monthlyPrice      Decimal  @map("monthly_price") @db.Decimal(12, 2)
  installationPrice Decimal  @default(0) @map("installation_price") @db.Decimal(12, 2)
  currency          String   @default("PKR") @db.Char(3)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([planId, cityId])
  @@index([cityId, isActive])
  @@map("plan_prices")
}

/* ============================================================================
   Tax rules
   ============================================================================ */

enum TaxKind {
  PERCENTAGE
  FIXED
}

enum TaxTarget {
  SUBSCRIPTION
  ADDON
  INSTALLATION
}

model TaxRule {
  id            String      @id @default(uuid()) @db.Uuid
  code          String      @unique
  label         String
  kind          TaxKind
  rate          Decimal     @default(0) @db.Decimal(6, 3)
  fixedAmount   Decimal     @default(0) @map("fixed_amount") @db.Decimal(12, 2)
  appliesTo     TaxTarget[] @map("applies_to")
  isActive      Boolean     @default(true) @map("is_active")
  effectiveFrom DateTime?   @map("effective_from")
  effectiveTo   DateTime?   @map("effective_to")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  cityRules CityTaxRule[]

  @@index([isActive])
  @@map("tax_rules")
}

/// Applies a tax rule to a city, optionally overriding its rate.
model CityTaxRule {
  id           String   @id @default(uuid()) @db.Uuid
  cityId       String   @map("city_id") @db.Uuid
  taxRuleId    String   @map("tax_rule_id") @db.Uuid
  rateOverride Decimal? @map("rate_override") @db.Decimal(6, 3)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  city    City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  taxRule TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  @@unique([cityId, taxRuleId])
  @@index([cityId, isActive])
  @@map("city_tax_rules")
}

/* ============================================================================
   Customers
   ============================================================================ */

enum CustomerStatus {
  PROSPECT
  ACTIVE
  SUSPENDED
  CHURNED
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  accountNumber  String         @unique @map("account_number")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String
  mobile         String
  alternatePhone String?        @map("alternate_phone")
  cnicLast4      String?        @map("cnic_last4")
  status         CustomerStatus @default(PROSPECT)
  cityId         String         @map("city_id") @db.Uuid
  areaId         String?        @map("area_id") @db.Uuid
  subAreaId      String?        @map("sub_area_id") @db.Uuid
  addressLine    String         @map("address_line")
  /// Positive means the customer owes money.
  balance        Decimal        @default(0) @db.Decimal(12, 2)
  currency       String         @default("PKR") @db.Char(3)
  autoPayEnabled Boolean        @default(false) @map("auto_pay_enabled")
  activatedAt    DateTime?      @map("activated_at")
  churnedAt      DateTime?      @map("churned_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          City              @relation(fields: [cityId], references: [id])
  area          Area?             @relation(fields: [areaId], references: [id], onDelete: SetNull)
  subArea       SubArea?          @relation(fields: [subAreaId], references: [id], onDelete: SetNull)
  addresses     CustomerAddress[]
  applications  Application[]
  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]
  tickets       Ticket[]

  @@index([status, createdAt])
  @@index([cityId])
  @@index([mobile])
  @@index([email])
  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  label       String
  addressLine String   @map("address_line")
  landmark    String?
  cityId      String   @map("city_id") @db.Uuid
  areaId      String?  @map("area_id") @db.Uuid
  subAreaId   String?  @map("sub_area_id") @db.Uuid
  isPrimary   Boolean  @default(false) @map("is_primary")
  isBilling   Boolean  @default(false) @map("is_billing")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

/* ============================================================================
   Applications
   ============================================================================ */

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  PAYMENT_PENDING
  PAYMENT_RECEIVED
  APPROVED
  INSTALLATION_SCHEDULED
  INSTALLATION_IN_PROGRESS
  ACTIVE
  REJECTED
  CANCELLED
}

model Application {
  id           String            @id @default(uuid()) @db.Uuid
  reference    String            @unique
  status       ApplicationStatus @default(DRAFT)
  firstName    String            @map("first_name")
  lastName     String            @map("last_name")
  email        String
  mobile       String
  cnicLast4    String?           @map("cnic_last4")
  cityId       String            @map("city_id") @db.Uuid
  areaId       String?           @map("area_id") @db.Uuid
  subAreaId    String?           @map("sub_area_id") @db.Uuid
  addressLine  String            @map("address_line")
  nearestLandmark String?        @map("nearest_landmark")
  services     ServiceType[]
  planId       String?           @map("plan_id") @db.Uuid
  addonIds     String[]          @map("addon_ids") @db.Uuid
  /// Frozen server-computed price breakdown captured at submission time.
  quote        Json?
  preferredInstallationDate DateTime? @map("preferred_installation_date") @db.Date
  scheduledInstallationDate DateTime? @map("scheduled_installation_date") @db.Date
  notes        String?
  termsAcceptedAt  DateTime?     @map("terms_accepted_at")
  mobileVerifiedAt DateTime?     @map("mobile_verified_at")
  submittedAt  DateTime?         @map("submitted_at")
  reviewedAt   DateTime?         @map("reviewed_at")
  reviewedById String?           @map("reviewed_by_id") @db.Uuid
  rejectionReason String?        @map("rejection_reason")
  customerId   String?           @map("customer_id") @db.Uuid
  ipAddress    String?           @map("ip_address")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  city          City      @relation(fields: [cityId], references: [id])
  area          Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  subArea       SubArea?  @relation(fields: [subAreaId], references: [id], onDelete: SetNull)
  plan          Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reviewedBy    User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  statusHistory ApplicationStatusHistory[]
  subscription  Subscription?

  @@index([status, createdAt])
  @@index([cityId, status])
  @@index([mobile])
  @@index([customerId])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus  @map("to_status")
  reason        String?
  changedById   String?            @map("changed_by_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
  @@map("application_status_history")
}

/* ============================================================================
   Subscriptions
   ============================================================================ */

enum SubscriptionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum SubscriptionChangeType {
  UPGRADE
  DOWNGRADE
  ADDON_ADDED
  ADDON_REMOVED
  SERVICE_ACTIVATED
  SERVICE_SUSPENDED
  REACTIVATED
  CANCELLED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  CANCELLED
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  reference          String             @unique
  customerId         String             @map("customer_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  applicationId      String?            @unique @map("application_id") @db.Uuid
  cityId             String             @map("city_id") @db.Uuid
  status             SubscriptionStatus @default(PENDING)
  services           ServiceType[]
  monthlyAmount      Decimal            @map("monthly_amount") @db.Decimal(12, 2)
  currency           String             @default("PKR") @db.Char(3)
  startedAt          DateTime?          @map("started_at")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  nextBillingDate    DateTime?          @map("next_billing_date") @db.Date
  suspendedAt        DateTime?          @map("suspended_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  customer       Customer                    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan           Plan                        @relation(fields: [planId], references: [id])
  application    Application?                @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  city           City                        @relation(fields: [cityId], references: [id])
  items          SubscriptionItem[]
  history        SubscriptionHistory[]
  changeRequests SubscriptionChangeRequest[]
  invoices       Invoice[]

  @@index([customerId, status])
  @@index([status, nextBillingDate])
  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionItem {
  id             String      @id @default(uuid()) @db.Uuid
  subscriptionId String      @map("subscription_id") @db.Uuid
  serviceType    ServiceType @map("service_type")
  label          String
  addonId        String?     @map("addon_id") @db.Uuid
  quantity       Int         @default(1)
  unitPrice      Decimal     @map("unit_price") @db.Decimal(12, 2)
  currency       String      @default("PKR") @db.Char(3)
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon        PlanAddon?   @relation(fields: [addonId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, isActive])
  @@map("subscription_items")
}

model SubscriptionHistory {
  id             String                 @id @default(uuid()) @db.Uuid
  subscriptionId String                 @map("subscription_id") @db.Uuid
  changeType     SubscriptionChangeType @map("change_type")
  fromValue      String?                @map("from_value")
  toValue        String?                @map("to_value")
  reason         String?
  changedById    String?                @map("changed_by_id") @db.Uuid
  createdAt      DateTime               @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt])
  @@map("subscription_history")
}

model SubscriptionChangeRequest {
  id               String                 @id @default(uuid()) @db.Uuid
  subscriptionId   String                 @map("subscription_id") @db.Uuid
  changeType       SubscriptionChangeType @map("change_type")
  requestedPlanId  String?                @map("requested_plan_id") @db.Uuid
  requestedAddonId String?                @map("requested_addon_id") @db.Uuid
  status           ChangeRequestStatus    @default(PENDING)
  customerNote     String?                @map("customer_note")
  adminNote        String?                @map("admin_note")
  effectiveFrom    DateTime?              @map("effective_from")
  reviewedAt       DateTime?              @map("reviewed_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  requestedPlan  Plan?        @relation(fields: [requestedPlanId], references: [id], onDelete: SetNull)
  requestedAddon PlanAddon?   @relation(fields: [requestedAddonId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, status])
  @@index([status, createdAt])
  @@map("subscription_change_requests")
}

/* ============================================================================
   Billing
   ============================================================================ */

enum InvoiceStatus {
  DRAFT
  GENERATED
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum InvoiceItemType {
  SUBSCRIPTION
  ADDON
  INSTALLATION
  EQUIPMENT
  DISCOUNT
  ADJUSTMENT
  LATE_FEE
}

model Invoice {
  id                 String        @id @default(uuid()) @db.Uuid
  invoiceNumber      String        @unique @map("invoice_number")
  customerId         String        @map("customer_id") @db.Uuid
  subscriptionId     String?       @map("subscription_id") @db.Uuid
  status             InvoiceStatus @default(DRAFT)
  billingPeriodStart DateTime      @map("billing_period_start") @db.Date
  billingPeriodEnd   DateTime      @map("billing_period_end") @db.Date
  issuedAt           DateTime?     @map("issued_at")
  dueDate            DateTime      @map("due_date") @db.Date
  subtotal           Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal       @default(0) @map("discount_total") @db.Decimal(12, 2)
  taxTotal           Decimal       @default(0) @map("tax_total") @db.Decimal(12, 2)
  total              Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid         Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  currency           String        @default("PKR") @db.Char(3)
  notes              String?
  pdfKey             String?       @map("pdf_key")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([subscriptionId, billingPeriodStart])
  @@index([customerId, status])
  @@index([status, dueDate])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String          @id @default(uuid()) @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  type        InvoiceItemType
  description String
  quantity    Int             @default(1)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(12, 2)
  amount      Decimal         @db.Decimal(12, 2)
  taxRate     Decimal         @default(0) @map("tax_rate") @db.Decimal(6, 3)
  taxAmount   Decimal         @default(0) @map("tax_amount") @db.Decimal(12, 2)
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  MOBILE_WALLET
  CASH
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  reference  String        @unique
  invoiceId  String?       @map("invoice_id") @db.Uuid
  customerId String        @map("customer_id") @db.Uuid
  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("PKR") @db.Char(3)
  method     PaymentMethod
  provider   String
  status     PaymentStatus @default(INITIATED)
  /// A masked descriptor such as "Visa ending 4242". Never a full card number.
  instrumentLabel   String? @map("instrument_label")
  providerReference String? @map("provider_reference")
  failureReason     String? @map("failure_reason")
  /// Uniqueness on this column is what makes "Pay now" safe to double-click.
  idempotencyKey String   @unique @map("idempotency_key")
  paidAt         DateTime? @map("paid_at")
  refundedAmount Decimal  @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  invoice      Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([customerId, status])
  @@index([invoiceId])
  @@index([status, createdAt])
  @@index([providerReference])
  @@map("payments")
}

/// Append-only ledger of every provider interaction for one payment.
model PaymentTransaction {
  id                String        @id @default(uuid()) @db.Uuid
  paymentId         String        @map("payment_id") @db.Uuid
  kind              String
  status            PaymentStatus
  amount            Decimal       @db.Decimal(12, 2)
  providerReference String?       @map("provider_reference")
  /// Provider response with secrets stripped before persistence.
  responseSummary   Json          @default("{}") @map("response_summary")
  createdAt         DateTime      @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
}

/// Raw webhook receipts. `eventId` uniqueness gives us replay protection.
model PaymentWebhook {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  eventType   String    @map("event_type")
  payload     Json
  signature   String?
  verified    Boolean   @default(false)
  processedAt DateTime? @map("processed_at")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("payment_webhooks")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSED
  REJECTED
  FAILED
}

model Refund {
  id                String       @id @default(uuid()) @db.Uuid
  paymentId         String       @map("payment_id") @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @default("PKR") @db.Char(3)
  status            RefundStatus @default(REQUESTED)
  reason            String
  requestedById     String?      @map("requested_by_id") @db.Uuid
  providerReference String?      @map("provider_reference")
  processedAt       DateTime?    @map("processed_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedBy User?   @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
}

/* ============================================================================
   Support
   ============================================================================ */

model SupportCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  description  String?
  iconKey      String?  @map("icon_key")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tickets Ticket[]

  @@index([isActive, displayOrder])
  @@map("support_categories")
}

model FaqCategory {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  slug         String   @unique
  description  String?
  iconKey      String?  @map("icon_key")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  faqs Faq[]

  @@index([displayOrder])
  @@map("faq_categories")
}

model Faq {
  id           String        @id @default(uuid()) @db.Uuid
  question     String
  slug         String        @unique
  answer       String
  categoryId   String?       @map("category_id") @db.Uuid
  tags         String[]
  status        PublishStatus @default(PUBLISHED)
  displayOrder  Int           @default(0) @map("display_order")
  helpfulCount  Int           @default(0) @map("helpful_count")
  viewCount     Int           @default(0) @map("view_count")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  category FaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, displayOrder])
  @@index([categoryId])
  @@map("faqs")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Ticket {
  id              String         @id @default(uuid()) @db.Uuid
  reference       String         @unique
  subject         String
  description     String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  categoryId      String?        @map("category_id") @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid
  assignedToId    String?        @map("assigned_to_id") @db.Uuid
  firstResponseAt DateTime?      @map("first_response_at")
  resolvedAt      DateTime?      @map("resolved_at")
  closedAt        DateTime?      @map("closed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  category      SupportCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  customer      Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedTo    User?                 @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages      TicketMessage[]
  attachments   TicketAttachment[]
  statusHistory TicketStatusHistory[]

  @@index([customerId, status])
  @@index([status, priority, createdAt])
  @@index([assignedToId, status])
  @@map("tickets")
}

enum TicketAuthorType {
  CUSTOMER
  AGENT
  SYSTEM
}

model TicketMessage {
  id         String           @id @default(uuid()) @db.Uuid
  ticketId   String           @map("ticket_id") @db.Uuid
  body       String
  authorId   String?          @map("author_id") @db.Uuid
  authorName String           @map("author_name")
  authorType TicketAuthorType @map("author_type")
  /// Internal notes are never serialised into a customer-facing response.
  isInternal Boolean          @default(false) @map("is_internal")
  createdAt  DateTime         @default(now()) @map("created_at")

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String?  @map("ticket_id") @db.Uuid
  messageId String?  @map("message_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  ticket  Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  media   MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([messageId])
  @@map("ticket_attachments")
}

model TicketStatusHistory {
  id          String        @id @default(uuid()) @db.Uuid
  ticketId    String        @map("ticket_id") @db.Uuid
  fromStatus  TicketStatus? @map("from_status")
  toStatus    TicketStatus  @map("to_status")
  note        String?
  changedById String?       @map("changed_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User?  @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@map("ticket_status_history")
}

enum CallbackStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PreferredTime {
  MORNING
  AFTERNOON
  EVENING
  ANYTIME
}

model CallbackRequest {
  id            String         @id @default(uuid()) @db.Uuid
  reference     String         @unique
  name          String
  phone         String
  email         String?
  cityId        String?        @map("city_id") @db.Uuid
  areaId        String?        @map("area_id") @db.Uuid
  preferredTime PreferredTime?  @map("preferred_time")
  subject       String
  message       String?
  status        CallbackStatus @default(NEW)
  assignedToId  String?        @map("assigned_to_id") @db.Uuid
  internalNote  String?        @map("internal_note")
  contactedAt   DateTime?      @map("contacted_at")
  completedAt   DateTime?      @map("completed_at")
  ipAddress     String?        @map("ip_address")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  city       City? @relation(fields: [cityId], references: [id], onDelete: SetNull)
  area       Area? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  assignedTo User? @relation("CallbackAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([cityId])
  @@index([assignedToId])
  @@map("callback_requests")
}

/* ============================================================================
   Notifications
   ============================================================================ */

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  event     String
  channel   NotificationChannel
  status    NotificationStatus  @default(QUEUED)
  title     String
  body      String
  href      String?
  payload   Json                @default("{}")
  error     String?
  sentAt    DateTime?           @map("sent_at")
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([channel, status])
  @@map("notifications")
}

/* ============================================================================
   Content management
   ============================================================================ */

enum SlideTheme {
  DARK
  LIGHT
}

model HeroSlide {
  id                 String        @id @default(uuid()) @db.Uuid
  eyebrow            String?
  headline           String
  headlineAccent     String?       @map("headline_accent")
  subheadline        String?
  desktopImageUrl    String?       @map("desktop_image_url")
  mobileImageUrl     String?       @map("mobile_image_url")
  videoUrl           String?       @map("video_url")
  imageAlt           String        @map("image_alt")
  primaryCtaLabel    String?       @map("primary_cta_label")
  primaryCtaHref     String?       @map("primary_cta_href")
  secondaryCtaLabel  String?       @map("secondary_cta_label")
  secondaryCtaHref   String?       @map("secondary_cta_href")
  theme              SlideTheme    @default(DARK)
  status             PublishStatus @default(DRAFT)
  displayOrder       Int           @default(0) @map("display_order")
  publishedAt        DateTime?     @map("published_at")
  expiresAt          DateTime?     @map("expires_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  @@index([status, displayOrder])
  @@map("hero_slides")
}

model CmsPage {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  title          String
  excerpt        String?
  body           String?
  status         PublishStatus @default(DRAFT)
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  ogImageUrl     String?       @map("og_image_url")
  noIndex        Boolean       @default(false) @map("no_index")
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  sections CmsSection[]

  @@index([status])
  @@map("cms_pages")
}

enum CmsSectionKind {
  HERO
  PRODUCT_TRIO
  BENEFITS
  FEATURED_PLANS
  PROMOTIONS
  COVERAGE
  FAQ
  CTA
  RICH_TEXT
  FEATURE_GRID
  PAYMENT_METHODS
}

model CmsSection {
  id            String         @id @default(uuid()) @db.Uuid
  key           String         @unique
  kind          CmsSectionKind
  pageId        String?        @map("page_id") @db.Uuid
  eyebrow       String?
  heading       String?
  headingAccent String?        @map("heading_accent")
  subheading    String?
  body          String?
  ctaLabel      String?        @map("cta_label")
  ctaHref       String?        @map("cta_href")
  imageUrl      String?        @map("image_url")
  content       Json           @default("{}")
  status        PublishStatus  @default(DRAFT)
  displayOrder  Int            @default(0) @map("display_order")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  page CmsPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, displayOrder])
  @@index([status])
  @@map("cms_sections")
}

model MediaAsset {
  id         String   @id @default(uuid()) @db.Uuid
  /// Storage key. Always generated by us — an uploaded filename is never trusted as a path.
  key        String   @unique
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  Int      @map("size_bytes")
  width      Int?
  height     Int?
  altText    String?  @map("alt_text")
  provider   String   @default("local")
  uploadedById String? @map("uploaded_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  ticketAttachments TicketAttachment[]

  @@index([createdAt])
  @@map("media_assets")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/* ============================================================================
   Analytics and audit
   ============================================================================ */

model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  path       String?
  cityId     String?  @map("city_id") @db.Uuid
  planId     String?  @map("plan_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  sessionId  String?  @map("session_id")
  properties Json     @default("{}")
  /// Truncated to a /24 prefix before storage; we never keep a full visitor address.
  ipPrefix   String?  @map("ip_prefix")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  city City? @relation(fields: [cityId], references: [id], onDelete: SetNull)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([createdAt])
  @@index([cityId])
  @@map("analytics_events")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  /// Redacted before write: passwords, OTP codes, tokens and card data never reach this column.
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Generic idempotency guard for non-payment POST endpoints.
model IdempotencyRecord {
  id           String   @id @default(uuid()) @db.Uuid
  key          String   @unique
  endpoint     String
  userId       String?  @map("user_id") @db.Uuid
  responseBody Json     @map("response_body")
  statusCode   Int      @map("status_code")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("idempotency_records")
}
