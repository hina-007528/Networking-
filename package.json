{
  "name": "stormfiber-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade ISP platform: public website, customer portal, admin console and API",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "npm run test:e2e -w @stormfiber/web",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "npm run prisma:generate -w @stormfiber/api",
    "db:migrate": "npm run prisma:migrate -w @stormfiber/api",
    "db:deploy": "npm run prisma:deploy -w @stormfiber/api",
    "db:seed": "npm run prisma:seed -w @stormfiber/api",
    "db:validate": "npm run prisma:validate -w @stormfiber/api",
    "db:studio": "npm run prisma:studio -w @stormfiber/api",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose up -d --build",
    "build:api:render": "node scripts/render-api-build.cjs",
    "install:render": "npm install --include=dev"
  },
  "allowScripts": {
    "@nestjs/core@10.4.15": false,
    "@prisma/client@6.2.1": true,
    "@prisma/engines@6.2.1": true,
    "@scarf/scarf@1.4.0": false,
    "@swc/core@1.16.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.23.1": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.2.1": true,
    "sharp@0.33.5": true
  },
  "dependencies": {
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/node": "22.10.7",
    "eslint": "9.18.0",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "turbo": "2.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.21.0",
    "vitest": "2.1.8"
  }
}
