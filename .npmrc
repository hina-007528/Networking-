# `hoisted` avoids the symlinked store layout. Windows hosts without Developer Mode enabled
# cannot create the symlinks pnpm's default `isolated` linker relies on.
node-linker=hoisted
auto-install-peers=true
strict-peer-dependencies=false
# Workspace packages are resolved via TypeScript path mappings. Linking them with
# real symlinks fails on Windows hosts that do not have Developer Mode enabled.
link-workspace-packages=false
prefer-workspace-packages=true
package-import-method=copy
inject-workspace-packages=true
